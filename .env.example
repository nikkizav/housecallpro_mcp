# Housecall Pro MCP Server — Environment Variables
#
# Most people do NOT need this file. The setup wizard puts your key in the Claude
# Desktop config instead. Copy this to .env only if you want to run the server
# directly from a terminal.

# Required: your Housecall Pro API key.
# Find it in Housecall Pro:
#   1. Top bar > My Apps tile (nine small squares, next to Settings)
#   2. Go to App Store
#   3. Search for "API"
#   4. API Key Management tile
#   5. Generate a new API key — name it "Claude"
# Requires the MAX plan.
HOUSECALL_PRO_API_KEY=your_api_key_here

# Optional: point at a config file somewhere other than ./config.json
# HCP_CONFIG_PATH=/absolute/path/to/config.json
